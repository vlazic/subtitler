# Cloud transcription (optional; the default path is fully local).
# A comma-separated list is also accepted and rotated per request.
GROQ_API_KEY=
GROQ_API_KEYS=

# Optional LLM post-edit pass (`--fix`). Only the provider you actually use is needed.
# --fix-model takes a LiteLLM model string, e.g. anthropic/claude-sonnet-5,
# openai/gpt-4o, groq/llama-3.3-70b-versatile, ollama/llama3.1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
